{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@hadk/*": ["packages/*/src/index.ts"]
    },
    "noEmit": true
  },
  "references": [
    { "path": "packages/core" },
    { "path": "packages/state-store" },
    { "path": "packages/orchestrator" },
    { "path": "packages/scaffold-engine" },
    { "path": "packages/validators" },
    { "path": "packages/hyperframes-adapter" },
    { "path": "packages/agent-adapters" },
    { "path": "packages/competition-intelligence" },
    { "path": "packages/planning" },
    { "path": "packages/agent-bridge" },
    { "path": "packages/verification" },
    { "path": "packages/submission" },
    { "path": "packages/workspace" },
    { "path": "packages/cli" }
  ],
  "include": ["tests/**/*.ts"]
}
