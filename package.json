{
  "name": "hackathon-ai-devkit",
  "version": "2.0.5",
  "private": true,
  "description": "AI-native Competition Engineering Harness — turn any competition brief into a winning strategy, scoped prototype, executable project scaffold, reliable demo, and submission-ready package.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"packages/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "node packages/cli/dist/index.js validate registry",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "globals": "^17.7.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.0.0"
  }
}
