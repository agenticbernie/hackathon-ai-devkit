{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agenticbernie.dev/hadk/schemas/project-scope.schema.json",
  "title": "HADK Locked Project Scope",
  "description": "Machine-readable scope contract produced by `hadk scope` and consumed by the scaffold engine. Once status is 'locked', new features require an explicit replan.",
  "type": "object",
  "required": ["project", "scope"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["hackathon", "buildathon", "startup-contest"] }
      }
    },
    "scope": {
      "type": "object",
      "required": ["status", "core_demo_flow", "mvp_features", "primary_wow_moment", "time_budget"],
      "properties": {
        "status": { "type": "string", "enum": ["unlocked", "locked"] },
        "core_demo_flow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["step", "user_action", "system_response", "proof_shown"],
            "properties": {
              "step": { "type": "integer", "minimum": 1 },
              "user_action": { "type": "string" },
              "system_response": { "type": "string" },
              "proof_shown": { "type": "string" }
            }
          }
        },
        "mvp_features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "purpose", "estimated_hours"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "required_for_demo": { "type": "boolean" },
              "required_for_rubric": { "type": "boolean" },
              "estimated_hours": { "type": "number", "minimum": 0 },
              "dependencies": { "type": "array", "items": { "type": "string" } },
              "fallback": { "type": "string" }
            }
          }
        },
        "deferred_features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "reason_deferred"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "reason_deferred": { "type": "string" }
            }
          }
        },
        "primary_wow_moment": {
          "type": "object",
          "required": ["description", "demo_step", "judge_takeaway"],
          "properties": {
            "description": { "type": "string" },
            "demo_step": { "type": "integer" },
            "judge_takeaway": { "type": "string" }
          }
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "risk"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "risk": { "type": "string", "enum": ["low", "medium", "high"] },
              "fallback": { "type": "string" }
            }
          }
        },
        "time_budget": {
          "type": "object",
          "required": ["implementation_hours"],
          "properties": {
            "implementation_hours": { "type": "number", "minimum": 0 },
            "integration_hours": { "type": "number", "minimum": 0 },
            "validation_hours": { "type": "number", "minimum": 0 },
            "demo_hours": { "type": "number", "minimum": 0 },
            "submission_hours": { "type": "number", "minimum": 0 },
            "buffer_hours": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
