{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticbernie.dev/hadk/v2.1/artifact-metadata.schema.json",
  "title": "HADK v2.1 artifact metadata",
  "type": "object",
  "required": ["schema_version", "created_at", "updated_at", "created_by", "source_refs", "assumptions", "blockers", "evidence_refs", "verification_status"],
  "properties": {
    "schema_version": { "type": "string", "const": "2.1" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "verification_status": { "enum": ["planned", "in_progress", "blocked", "unverified", "verified", "agent_reported", "human_attested"] }
  }
}
