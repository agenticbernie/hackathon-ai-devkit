{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticbernie.dev/hadk/v2.1/scope.schema.json",
  "title": "Locked scope",
  "type": "object",
  "required": ["schema_version", "mvp_features", "core_demo_flow", "primary_proof_point", "cut_list", "implementation_budget", "integration_budget", "verification_budget", "demo_rehearsal_budget", "buffer", "risk_budget", "reset_seed_strategy"],
  "properties": {
    "schema_version": { "const": "2.1" }, "mvp_features": { "type": "array" }, "core_demo_flow": { "type": "array", "minItems": 1 },
    "primary_proof_point": { "type": "string", "minLength": 1 }, "cut_list": { "type": "array" }, "implementation_budget": { "type": "number" },
    "integration_budget": { "type": "number" }, "verification_budget": { "type": "number" }, "demo_rehearsal_budget": { "type": "number" },
    "buffer": { "type": "number" }, "risk_budget": { "type": "number" }, "reset_seed_strategy": { "type": "string" }
  }
}
