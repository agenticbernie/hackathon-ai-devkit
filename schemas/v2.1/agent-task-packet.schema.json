{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticbernie.dev/hadk/v2.1/agent-task-packet.schema.json",
  "title": "Agent task packet",
  "type": "object",
  "required": ["schema_version", "task_id", "feature_id", "scope_version", "architecture_version", "objective", "allowed_files", "forbidden_files", "acceptance_criteria", "required_tests", "verification_commands", "dependencies", "fallback", "expected_result_schema"],
  "properties": {
    "schema_version": { "const": "2.1" }, "task_id": { "type": "string" }, "feature_id": { "type": "string" }, "scope_version": { "type": "string" }, "architecture_version": { "type": "string" }, "objective": { "type": "string" },
    "allowed_files": { "type": "array", "items": { "type": "string", "minLength": 1, "not": { "pattern": "(^|/)\\.\\.(/|$)" } } },
    "forbidden_files": { "type": "array", "items": { "type": "string", "minLength": 1, "not": { "pattern": "(^|/)\\.\\.(/|$)" } } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_tests": { "type": "array", "items": { "type": "string", "pattern": "^tests/[^/]+\\.test\\.[jt]sx?$" } },
    "verification_commands": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "not": { "pattern": "[;&|`$()<>]" } } } },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "fallback": { "type": "string", "minLength": 1 },
    "expected_result_schema": { "type": "string", "pattern": "^schemas/v2\\.1/[A-Za-z0-9._-]+\\.schema\\.json$" }
  }
}
