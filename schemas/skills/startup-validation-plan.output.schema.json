  "properties": {"schema_version": {"const": "1.0"}, "validation_plan_id": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "source_pain_point_id": {"type": "string"}, "hypotheses": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "statement", "category", "importance", "current_confidence", "validation_method", "target_participants", "sample_size", "interview_or_test_questions", "success_threshold", "falsification_threshold", "timeline", "owner", "evidence_to_capture", "status", "next_decision"], "properties": {"id": {"type": "string"}, "statement": {"type": "string"}, "category": {"enum": ["problem", "frequency", "severity", "urgency", "user", "buyer", "willingness_to_pay", "workflow", "distribution", "solution", "retention"]}, "importance": {"enum": ["low", "medium", "high", "critical"]}, "current_confidence": {"enum": ["low", "medium", "high"]}, "validation_method": {"enum": ["user_interview", "expert_interview", "survey", "landing_page_test", "fake_door_test", "concierge_mvp", "prototype_usability_test", "pilot", "pre_order", "letter_of_intent", "manual_workflow_experiment"]}, "target_participants": {"type": "string"}, "sample_size": {"type": "integer", "minimum": 1}, "interview_or_test_questions": {"type": "array", "items": {"type": "string"}}, "success_threshold": {"type": "string", "minLength": 1}, "falsification_threshold": {"type": "string", "minLength": 1}, "timeline": {"type": "string"}, "owner": {"type": "string"}, "evidence_to_capture": {"type": "string", "minLength": 1}, "status": {"enum": ["planned", "in_progress", "complete", "blocked"]}, "next_decision": {"type": "string", "minLength": 1}}, "additionalProperties": false}}, "sequence": {"type": "array", "items": {"type": "string"}}, "decision_rules": {"type": "array", "items": {"type": "string"}}, "expected_outcomes": {"type": "array", "items": {"type": "string"}}, "recommended_next_skill": {"const": "startup-customer-evidence"}}
}
