{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agenticbernie.dev/hadk/skills/startup-opportunity-scorecard.output.schema.json",
  "title": "Startup Opportunity Scorecard Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scorecard_id", "created_at", "scoring_method", "dimensions", "pain_point_scores", "ranking", "recommended_pain_point_id", "decision", "next_skill"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scorecard_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "scoring_method": {"type": "string"},
    "dimensions": {"type": "object", "additionalProperties": {"type": "object", "required": ["weight", "scale"], "properties": {"weight": {"type": "number", "minimum": 0}, "scale": {"const": "1-5"}}, "additionalProperties": false}},
    "pain_point_scores": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["pain_point_id", "pain_point", "scores", "weighted_score", "score_confidence", "key_risks", "missing_evidence", "recommended_action"], "properties": {"pain_point_id": {"type": "string"}, "pain_point": {"type": "string"}, "scores": {"type": "object", "additionalProperties": {"type": "object", "required": ["score", "rationale", "evidence", "confidence", "evidence_status"], "properties": {"score": {"type": "integer", "minimum": 1, "maximum": 5}, "rationale": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}, "confidence": {"enum": ["low", "medium", "high"]}, "evidence_status": {"enum": ["validated", "assumed", "hypothetical"]}}, "additionalProperties": false}}, "weighted_score": {"type": "number"}, "score_confidence": {"enum": ["low", "medium", "high"]}, "key_risks": {"type": "array", "items": {"type": "string"}}, "missing_evidence": {"type": "array", "items": {"type": "string"}}, "recommended_action": {"enum": ["deep_dive", "validate", "collect_more_evidence", "deprioritize", "reject"]}}, "additionalProperties": false}},
    "ranking": {"type": "array", "items": {"type": "object", "required": ["pain_point_id", "rank", "weighted_score", "recommendation"], "properties": {"pain_point_id": {"type": "string"}, "rank": {"type": "integer", "minimum": 1}, "weighted_score": {"type": "number"}, "recommendation": {"enum": ["deep_dive", "validate", "collect_more_evidence", "deprioritize", "reject"]}}, "additionalProperties": false}},
    "recommended_pain_point_id": {"type": "string"},
    "decision": {"type": "string"},
    "next_skill": {"const": "startup-pain-point-deep-dive"},
    "source_deep_dive_id": {"type": ["string", "null"]},
    "provenance": {"type": "array", "items": {"type": "object"}},
    "generation": {"type": "object", "properties": {"mode": {"type": "string"}, "agent_intent": {"type": ["string", "null"]}}, "additionalProperties": false}
  }
}
